import { connect, query, execute, close } from "std/db/sqlite"
import { cwd, get_env } from "std/env"
import { is_absolute } from "std/path"

fn database_path() -> String {
    let configured = get_env("APP_DATABASE_PATH") ?? "data/app.db"
    // A durable application database, never an in-memory substitute.
    assert(configured != "" && configured != ":memory:")
    return if is_absolute(configured) { configured } else { cwd() + "/" + configured }
}

// Every operation owns exactly one finite handle; none are cached at import time.
// Catch native rejection in a separate frame, then clean up in the owning frame.
fn guarded_query(handle, sql: String, params: Array) -> Result<Array, String> {
    let rows = query(handle, sql, params) otherwise { return Err("SQLite query failed") }
    return Ok(rows)
}
fn guarded_execute(handle, sql: String, params: Array) -> Result<Int, String> {
    let count = execute(handle, sql, params) otherwise { return Err("SQLite statement failed") }
    return Ok(count)
}
fn query_rows(sql: String, params: Array) -> Result<Array, String> {
    let handle = connect(database_path(), map { "busy_timeout_ms": 5000 }) otherwise { return Err("SQLite unavailable") }
    let outcome = guarded_query(handle, sql, params)
    close(handle)
    return outcome
}
fn execute_statement(sql: String, params: Array) -> Result<Int, String> {
    let handle = connect(database_path(), map { "busy_timeout_ms": 5000 }) otherwise { return Err("SQLite unavailable") }
    let outcome = guarded_execute(handle, sql, params)
    close(handle)
    return outcome
}

// DDL is owned by the release/zero-config local bootstrap, not server startup.
fn initialize_database() -> Bool {
    let rows = unwrap(query_rows("SELECT id FROM official_events LIMIT 1", []))
    if len(rows) != 1 { panic("Provision the database and import reviewed events before starting Iowa Plume Watch") }
    return true
}