import { execute, query } from "std/db/sqlite"
import { migrate as migrate_001 } from "migrations/001_snapshots"

// The only list to edit when adding a migration: import its `migrate` and append
// one entry. Never reorder, rename or edit an entry that has been applied.
fn migration_plan() -> Array {
    return [
        map { "version": "001_snapshots", "run": migrate_001 }
    ]
}

// Called only inside the startup owner's IMMEDIATE transaction.
fn apply_migrations(handle) -> Bool {
    unwrap(execute(handle, "CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY NOT NULL, applied_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)", []))
    for step in migration_plan() {
        let applied = unwrap(query(handle, "SELECT version FROM schema_migrations WHERE version = ?", [step["version"]]))
        if len(applied) == 0 {
            // Bind before calling: closures stored in maps are not dot-callable.
            let run = step["run"]
            run(handle)
            unwrap(execute(handle, "INSERT INTO schema_migrations (version) VALUES (?)", [step["version"]]))
        }
    }
    return true
}
