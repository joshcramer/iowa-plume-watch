import { response, not_found } from "std/http/server"
import { stringify } from "std/json"
import { persisted_payload } from "lib/snapshots"
import { official_log, official_status } from "lib/official"

fn reply(code: Int, body: String) {
    return response(code, map {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "no-store"
    }, body)
}

fn get(req) {
    let file = req.params["file"]
    if file == "official-status.json" { return reply(200, stringify(official_status())) }
    if file == "official-updates.json" { return reply(200, stringify(official_log())) }
    let name = if file == "forecast.json" { "forecast" }
        else if file == "extended-tracks.json" { "extended-tracks" }
        else if file == "source-watch.json" { "source-watch" }
        else { return not_found() }
    let body = persisted_payload(name) otherwise { return reply(503, "{}") }
    return reply(200, body)
}
