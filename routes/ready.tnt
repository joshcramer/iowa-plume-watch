import { json } from "std/http/server"
import { query_rows } from "lib/database"

// Readiness: storage is usable. /health stays a lightweight liveness probe.
// @implements: feature.starter_infra
fn get(req) {
    let rows = query_rows("SELECT id FROM official_events LIMIT 1", []) otherwise {
        return json(map { "status": "unavailable" }, 503)
    }
    if len(rows) != 1 { return json(map { "status": "unavailable" }, 503) }
    return json(map { "status": "ready" })
}
