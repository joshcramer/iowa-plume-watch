import { store_traffic, traffic_report, traffic_host } from "../lib/traffic.tnt"

let collected = 1795563600
let row = map { "day": "2026-11-23", "requests": 12, "bytes": 1200, "visits": 3, "views": 4, "crawler_views": 1 }
let envelope = map { "host": traffic_host(), "collected_at": collected, "days": [row] }
assert(traffic_report(collected)["available"] == false)
assert(unwrap(store_traffic(envelope)) == 1)
assert(unwrap(store_traffic(envelope)) == 1)
let good = traffic_report(collected)
assert(good["available"] == true && len(good["days"]) == 1)
assert(good["requests"] == 12 && good["visits"] == 3 && good["views"] == 4 && good["crawler_views"] == 1)
assert(good["stale"] == false)
assert(traffic_report(collected + 36 * 3600)["stale"] == true)
assert(is_err(store_traffic(map { "host": "other.heylarri.com", "collected_at": collected, "days": [row] })))
assert(is_err(store_traffic(map { "host": traffic_host(), "collected_at": collected, "days": [row, row] })))
assert(is_err(store_traffic(map { "host": traffic_host(), "collected_at": collected, "days": [] })))
assert(traffic_report(collected)["requests"] == 12)
assert(traffic_report(collected)["path_report"]["available"] == false)
let mut measured = row
measured["path_views"] = map { "/": 3, "/stats": 1 }
let updated = map { "host": traffic_host(), "collected_at": collected + 60, "days": [measured] }
assert(unwrap(store_traffic(updated)) == 1)
assert(unwrap(store_traffic(updated)) == 1)
let paths = traffic_report(collected + 60)["path_report"]
assert(paths["available"] == true && len(paths["series"]) == 2)
assert(paths["series"][0]["total"] == "3" && paths["series"][1]["total"] == "1")
assert(paths["rows"][0]["cells"][0] == "3" && paths["rows"][0]["cells"][1] == "1")
let mut bad = row
bad["path_views"] = map { "/": 1, "/stats?private=example": 3 }
assert(is_err(store_traffic(map { "host": traffic_host(), "collected_at": collected + 120, "days": [bad] })))
bad["path_views"] = map { "/": 1 }
assert(is_err(store_traffic(map { "host": traffic_host(), "collected_at": collected + 120, "days": [bad] })))
assert(unwrap(store_traffic(map { "host": traffic_host(), "collected_at": collected + 180, "days": [row] })) == 1)
assert(traffic_report(collected + 180)["path_report"]["series"][1]["total"] == "1")
let mut older = row
older["day"] = "2026-11-22"
let mut oldest = older
oldest["day"] = "2026-11-21"
oldest["path_views"] = map { "/": 0, "/stats": 0 }
assert(unwrap(store_traffic(map { "host": traffic_host(), "collected_at": collected + 180, "days": [older, oldest] })) == 2)
let gap = traffic_report(collected + 180)["path_report"]
assert(gap["incomplete"] == true && gap["rows"][1]["cells"][0] == "—" && gap["rows"][2]["cells"][0] == "0")
assert(gap["series"][0]["drawing"] == "M58 212 M608 74 ")
assert((traffic_report(collected + 180)["audience"] ?? map {})["available"] == false)
let mut tracked = measured
tracked["audience"] = map { "countries": map { "US": 3, "CA": 1 }, "devices": map { "mobile": 3, "desktop": 1 } }
let audience_batch = map { "host": traffic_host(), "collected_at": collected + 240, "days": [tracked] }
assert(unwrap(store_traffic(audience_batch)) == 1)
assert(unwrap(store_traffic(audience_batch)) == 1)
let view = traffic_report(collected + 240)["audience"]
assert(view["available"] && view["incomplete"])
assert(view["countries"][0]["label"] == "United States" && view["countries"][0]["share"] == "75%")
assert(view["countries"][1]["label"] == "Other countries" && view["countries"][1]["count"] == "1")
assert(view["devices"][0]["label"] == "Mobile" && view["devices"][0]["count"] == "3")
tracked["audience"] = map { "countries": map { "name.invalid": 4 }, "devices": map { "mobile": 4 } }
assert(is_err(store_traffic(map { "host": traffic_host(), "collected_at": collected + 300, "days": [tracked] })))
tracked["audience"] = map { "countries": map { "US": 4 }, "devices": map { "phone-model": 4 } }
assert(is_err(store_traffic(map { "host": traffic_host(), "collected_at": collected + 300, "days": [tracked] })))
assert(unwrap(store_traffic(map { "host": traffic_host(), "collected_at": collected + 360, "days": [row] })) == 1)
assert(traffic_report(collected + 360)["audience"]["devices"][0]["count"] == "3")
print("PASS: traffic import and path, device and country aggregates")
